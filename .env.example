ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET=your_alpaca_secret_here

# Default live data source: the Finnhub trade tape, aggregated into candles
# locally. Without it the app falls back to streaming bars from Alpaca.
FINNHUB_API_KEY=your_finnhub_key_here

# --- Order execution -------------------------------------------------------
# The app defaults to sending orders to your Alpaca PAPER account. If your
# ALPACA_API_KEY above is already a paper key, nothing more is needed; set these
# to point trading at a different paper account than the one serving data.
# ALPACA_PAPER_API_KEY=your_paper_key_here
# ALPACA_PAPER_SECRET=your_paper_secret_here

# LIVE trading — real money. Off unless ALPACA_ENABLE_LIVE_TRADING is truthy,
# and the app additionally requires a typed confirmation per run. Live keys are
# never inherited from the variables above: they must be named here.
# ALPACA_ENABLE_LIVE_TRADING=false
# ALPACA_LIVE_API_KEY=your_live_key_here
# ALPACA_LIVE_SECRET=your_live_secret_here

# Optional — only needed for LLM news impact scoring
GEMINI_API_KEY=your_gemini_key_here
WORLD_NEWS_API_KEY=your_worldnews_key_here
